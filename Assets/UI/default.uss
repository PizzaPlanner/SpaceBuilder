* {
    color: rgb(235, 238, 233);
}

.dockingbutton.docked {
    -unity-background-image-tint-color: rgb(81, 251, 255);
}

.dockingbutton.undocked > #Icon {
    background-image: url('project://database/Assets/3rdParty/64%20flat%20icons/png/64px/World_Compass.png?fileID=2800000&guid=dffb77e4777ab854e914e85c4670dbfe&type=3#World_Compass');
}

InventoryElement {
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-image: url('project://database/Assets/UI/bg_slim.png?fileID=2800000&guid=cc32439c45babc04593dca5896662d0a&type=3#bg_slim');
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    width: 260px;
    flex-direction: row;
    flex-wrap: wrap;
}

InventoryButton {
    width: 48px;
    height: 48px;
    background-image: url('project://database/Assets/UI/bg_default.png?fileID=2800000&guid=c73eb54f62139d64087a3e6d1e440760&type=3#bg_default');
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    flex-shrink: 0;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

InventoryButton:hover {
    background-color: rgb(147, 147, 147);
    -unity-background-image-tint-color: rgb(183, 214, 214);
}

InventoryButton.active {
    border-left-color: rgba(117, 231, 255, 0.33);
    border-right-color: rgba(117, 231, 255, 0.33);
    border-top-color: rgba(117, 231, 255, 0.33);
    border-bottom-color: rgba(117, 231, 255, 0.33);
}

.builder-button {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 5px;
    padding-right: 5px;
}

.builder-button__Active {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(85, 223, 241, 0.4);
    border-right-color: rgba(85, 223, 241, 0.4);
    border-top-color: rgba(85, 223, 241, 0.4);
    border-bottom-color: rgba(85, 223, 241, 0.4);
    margin-left: -1px;
    margin-right: -1px;
    margin-top: -1px;
    margin-bottom: -1px;
    background-color: rgba(23, 152, 183, 0.2);
}

.builder-button__Active > .selector {
    background-image: url('project://database/Assets/UI/crosshair.png?fileID=2800000&guid=18c36555461a00541bedc3bed7a78b41&type=3#crosshair');
    width: 16px;
    height: 16px;
    left: 0;
    margin-left: -16px;
}

.builder-button > .icon {
    width: 16px;
    height: 16px;
    background-image: url('project://database/Assets/UI/coorsys_system.png?fileID=2800000&guid=c2e97b68c263c2540b96550bf1f92d1a&type=3#coorsys_system');
}

.item-button > .name {
    font-size: 8px;
    bottom: 0;
    position: absolute;
    left: 50%;
    right: 50%;
    -unity-text-align: upper-center;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.item-button > .icon {
    background-image: url('project://database/Assets/UI/crosshair.png?fileID=2800000&guid=18c36555461a00541bedc3bed7a78b41&type=3#crosshair');
    flex-grow: 1;
    -unity-background-image-tint-color: rgb(115, 115, 115);
}

.item-button > .stack {
    position: absolute;
    right: 0;
    top: 0;
    -unity-text-align: upper-right;
    font-size: 10px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.admin-console > TextField {
    height: 24px;
    background-color: rgba(255, 255, 255, 0.07);
    flex-shrink: 0;
    flex-grow: 0;
    white-space: nowrap;
}

.admin-console > TextField > #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.admin-console {
    background-image: url('project://database/Assets/UI/bg_slim.png?fileID=2800000&guid=cc32439c45babc04593dca5896662d0a&type=3#bg_slim');
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    flex-direction: column;
}

.admin-console > ScrollView {
    flex-grow: 1;
    flex-shrink: 1;
}

.crafting-queue-item {
    border-left-color: rgba(255, 255, 255, 0.31);
    border-right-color: rgba(255, 255, 255, 0.31);
    border-top-color: rgba(255, 255, 255, 0.31);
    border-bottom-color: rgba(255, 255, 255, 0.31);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
    flex-direction: row;
}

.crafting-queue-item .progress-foreground {
    background-color: rgba(250, 255, 126, 0.62);
    flex-direction: row;
    justify-content: flex-start;
    height: 100%;
    width: 25%;
}

.crafting-recipe {
    border-left-color: rgba(255, 255, 255, 0.39);
    border-right-color: rgba(255, 255, 255, 0.39);
    border-top-color: rgba(255, 255, 255, 0.39);
    border-bottom-color: rgba(255, 255, 255, 0.39);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
    flex-direction: column;
}

.crafting-recipe:hover {
    background-color: rgba(23, 152, 183, 0.2);
    border-left-color: rgba(85, 223, 241, 0.4);
    border-right-color: rgba(85, 223, 241, 0.4);
    border-top-color: rgba(85, 223, 241, 0.4);
    border-bottom-color: rgba(85, 223, 241, 0.4);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.crafting-recipe__uncraftable:hover {
    background-color: rgba(183, 25, 23, 0.2);
    border-left-color: rgba(243, 69, 56, 0.4);
    border-right-color: rgba(243, 69, 56, 0.4);
    border-top-color: rgba(243, 69, 56, 0.4);
    border-bottom-color: rgba(243, 69, 56, 0.4);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.crafting-recipe .item-list {
    flex-direction: row;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

CraftingInputButton {
    width: 24px;
    height: 24px;
    background-image: url('project://database/Assets/UI/bg_default.png?fileID=2800000&guid=c73eb54f62139d64087a3e6d1e440760&type=3#bg_default');
}

CraftingInputButton.missing {
    -unity-background-image-tint-color: rgb(217, 26, 26);
}

CraftingInputButton > .name {
    display: none;
}

.poi-marker {
    justify-content: flex-start;
    align-items: flex-start;
}

.poi-marker Label {
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: upper-left;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 4px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    justify-content: flex-start;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    background-color: rgba(0, 0, 0, 0.67);
    align-items: flex-start;
    display: none;
    overflow: visible;
    align-self: auto;
    max-width: 0;
    transition-property: max-width;
    transition-duration: 0.5s;
}

.poi-marker.highlighted Label {
    display: flex;
    max-width: none;
    transition-property: max-width;
    transition-duration: 0.5s;
}

.poi-marker #Icon {
    width: 24px;
    height: 24px;
    background-image: url('project://database/Assets/UI/target_marker.png?fileID=2800000&guid=aef2665a177dcb043b9b9593211bf248&type=3#target_marker');
}

.poi-marker #Icon.Star {
    background-image: url('project://database/Assets/UI/target_marker_star.png?fileID=2800000&guid=903195b968a03134eaaa8b62d0efdc6f&type=3#target_marker_star');
}

.poi-marker #Icon.Planet {
    background-image: url('project://database/Assets/UI/target_marker_planet.png?fileID=2800000&guid=df2d46c2ef2e279489234579778b5db3&type=3#target_marker_planet');
}

.poi-marker > VisualElement {
    left: -12px;
    top: -12px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    align-self: flex-start;
}

.hotkey-label {
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    font-size: 16px;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.29);
}

BlueprintLibraryWindow {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    background-color: rgb(58, 58, 58);
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
}

BlueprintLibraryWindow > #Content {
    align-items: flex-start;
}

BlueprintLibraryElement {
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(22, 22, 22);
}

BlueprintLibraryElement > #SourceIcon {
    width: 12px;
    height: 12px;
    position: absolute;
    left: 0;
    top: 0;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

BlueprintLibraryElement > #SourceIcon.Local {
    background-image: url('project://database/Packages/com.unity.entities/Editor%20Default%20Resources/icons/selected/Group/Group@2x.png?fileID=2800000&guid=89c52489dfd6810458ffede3d1c38dab&type=3#Group@2x');
    -unity-background-image-tint-color: rgb(0, 157, 255);
}

BlueprintLibraryElement > #SourceIcon.Internal {
    background-image: url('project://database/Packages/com.unity.physics/Unity.Physics.Editor/Editor%20Default%20Resources/Icons/d_BoxCollider@64.png?fileID=2800000&guid=98cc11df2126340b79621985d8fd6d78&type=3#d_BoxCollider@64');
}

.debug-button {
    height: 24px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    color: rgb(202, 202, 202);
    background-color: rgb(67, 67, 67);
    -unity-text-align: upper-center;
}

.debug-button > .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    -unity-background-image-tint-color: rgb(0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.debug-button > .unity-base-field__input > TextElement {
    color: rgb(180, 180, 180);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

GridInfoWindow {
    background-color: rgba(0, 0, 0, 0.58);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    width: 400px;
}

#Name > .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0.47);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-left-color: rgb(159, 159, 159);
    border-right-color: rgb(159, 159, 159);
    border-top-color: rgb(159, 159, 159);
    border-bottom-color: rgb(159, 159, 159);
}

ActionButton {
    width: 32px;
    height: 32px;
    background-image: url('project://database/Assets/UI/crosshair.png?fileID=2800000&guid=18c36555461a00541bedc3bed7a78b41&type=3#crosshair');
    align-items: center;
    background-color: rgba(0, 89, 137, 0.51);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

ActionButton > #Hotkey {
    background-color: rgba(38, 38, 38, 0.5);
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
    -unity-text-align: upper-center;
    font-size: 14px;
    -unity-font-style: bold;
    top: -20px;
    padding-left: 1px;
    padding-right: 1px;
    padding-top: 1px;
    padding-bottom: 1px;
}

POIMarker > PlanetCircleMarker {
    display: none;
}

POIMarker.highlighted > PlanetCircleMarker {
    display: flex;
    position: absolute;
    left: 0;
    top: 0;
}

#Inputs.item-list {
    background-color: rgba(0, 161, 255, 0.08);
}

#Outputs.item-list {
    background-color: rgba(23, 255, 0, 0.1);
}

#Catalysts.item-list {
    background-color: rgba(255, 0, 234, 0.11);
}

#Outputs > CraftingInputButton {
    width: 32px;
    height: 32px;
    background-image: url('project://database/Assets/3rdParty/2000_Icons/fr_bg/bg_green.png?fileID=2800000&guid=23edd2c0a714f8448bb8d7e472920ba3&type=3#bg_green');
}

.crafting-recipe > * {
    flex-direction: row;
}

.crafting-queue-item .progress-background {
    background-color: rgba(255, 255, 255, 0.04);
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    flex-direction: row;
    justify-content: flex-start;
    display: flex;
    align-self: stretch;
    flex-grow: 1;
}
