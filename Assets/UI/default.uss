.dockingbutton-on {
    -unity-background-image-tint-color: rgb(81, 251, 255);
}

* {
    color: rgb(235, 238, 233);
}

.inventory-button {
    width: 48px;
    height: 48px;
    background-image: url('/Assets/UI/bg_default.png');
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    flex-shrink: 0;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.inventory-button__Active {
    border-left-color: rgba(117, 231, 255, 0.33);
    border-right-color: rgba(117, 231, 255, 0.33);
    border-top-color: rgba(117, 231, 255, 0.33);
    border-bottom-color: rgba(117, 231, 255, 0.33);
}

.builder-button {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 5px;
    padding-right: 5px;
}

.builder-button__Active {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(85, 223, 241, 0.4);
    border-right-color: rgba(85, 223, 241, 0.4);
    border-top-color: rgba(85, 223, 241, 0.4);
    border-bottom-color: rgba(85, 223, 241, 0.4);
    margin-left: -1px;
    margin-right: -1px;
    margin-top: -1px;
    margin-bottom: -1px;
    background-color: rgba(23, 152, 183, 0.2);
}

.builder-button__Active > .selector {
    background-image: url('/Assets/UI/crosshair.png');
    width: 16px;
    height: 16px;
    left: 0;
    margin-left: -16px;
}

.builder-button > .icon {
    width: 16px;
    height: 16px;
    background-image: url('/Assets/UI/coorsys_system.png');
}

.inventory-button > .name {
    font-size: 8px;
    bottom: 0;
    position: absolute;
    left: 50%;
    right: 50%;
    -unity-text-align: upper-center;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.inventory-button > .icon {
    background-image: url('/Assets/UI/crosshair.png');
    flex-grow: 1;
    -unity-background-image-tint-color: rgb(115, 115, 115);
}

.inventory-button > .stack {
    position: absolute;
    right: 0;
    top: 0;
    -unity-text-align: upper-right;
    font-size: 10px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.admin-console > TextField {
    height: 24px;
    background-color: rgba(255, 255, 255, 0.07);
    flex-shrink: 0;
    flex-grow: 0;
    white-space: nowrap;
}

.admin-console > TextField > #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.admin-console {
    background-image: url('/Assets/UI/bg_slim.png');
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    flex-direction: column;
}

.admin-console > ScrollView {
    flex-grow: 1;
    flex-shrink: 1;
}
