.dockingbutton-on {
    -unity-background-image-tint-color: rgb(81, 251, 255);
}

* {
    color: rgb(235, 238, 233);
}

.inventory {
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-image: url('project://database/Assets/UI/bg_slim.png?fileID=2800000&guid=cc32439c45babc04593dca5896662d0a&type=3#bg_slim');
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    width: 260px;
    flex-direction: row;
    flex-wrap: wrap;
}

.inventory-button {
    width: 48px;
    height: 48px;
    background-image: url('project://database/Assets/UI/bg_default.png?fileID=2800000&guid=c73eb54f62139d64087a3e6d1e440760&type=3#bg_default');
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    flex-shrink: 0;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.inventory-button:hover {
    background-color: rgb(147, 147, 147);
    -unity-background-image-tint-color: rgb(183, 214, 214);
}

.inventory-button__Active {
    border-left-color: rgba(117, 231, 255, 0.33);
    border-right-color: rgba(117, 231, 255, 0.33);
    border-top-color: rgba(117, 231, 255, 0.33);
    border-bottom-color: rgba(117, 231, 255, 0.33);
}

.builder-button {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 5px;
    padding-right: 5px;
}

.builder-button__Active {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(85, 223, 241, 0.4);
    border-right-color: rgba(85, 223, 241, 0.4);
    border-top-color: rgba(85, 223, 241, 0.4);
    border-bottom-color: rgba(85, 223, 241, 0.4);
    margin-left: -1px;
    margin-right: -1px;
    margin-top: -1px;
    margin-bottom: -1px;
    background-color: rgba(23, 152, 183, 0.2);
}

.builder-button__Active > .selector {
    background-image: url('project://database/Assets/UI/crosshair.png?fileID=2800000&guid=18c36555461a00541bedc3bed7a78b41&type=3#crosshair');
    width: 16px;
    height: 16px;
    left: 0;
    margin-left: -16px;
}

.builder-button > .icon {
    width: 16px;
    height: 16px;
    background-image: url('project://database/Assets/UI/coorsys_system.png?fileID=2800000&guid=c2e97b68c263c2540b96550bf1f92d1a&type=3#coorsys_system');
}

.inventory-button > .name {
    font-size: 8px;
    bottom: 0;
    position: absolute;
    left: 50%;
    right: 50%;
    -unity-text-align: upper-center;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.inventory-button > .icon {
    background-image: url('project://database/Assets/UI/crosshair.png?fileID=2800000&guid=18c36555461a00541bedc3bed7a78b41&type=3#crosshair');
    flex-grow: 1;
    -unity-background-image-tint-color: rgb(115, 115, 115);
}

.inventory-button > .stack {
    position: absolute;
    right: 0;
    top: 0;
    -unity-text-align: upper-right;
    font-size: 10px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.admin-console > TextField {
    height: 24px;
    background-color: rgba(255, 255, 255, 0.07);
    flex-shrink: 0;
    flex-grow: 0;
    white-space: nowrap;
}

.admin-console > TextField > #unity-text-input {
    background-color: rgba(255, 255, 255, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.admin-console {
    background-image: url('project://database/Assets/UI/bg_slim.png?fileID=2800000&guid=cc32439c45babc04593dca5896662d0a&type=3#bg_slim');
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    flex-direction: column;
}

.admin-console > ScrollView {
    flex-grow: 1;
    flex-shrink: 1;
}

.crafting-queue-item {
    border-left-color: rgba(255, 255, 255, 0.31);
    border-right-color: rgba(255, 255, 255, 0.31);
    border-top-color: rgba(255, 255, 255, 0.31);
    border-bottom-color: rgba(255, 255, 255, 0.31);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.crafting-queue-item .progress-background {
    height: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    flex-direction: row;
    justify-content: center;
    width: 150px;
    display: flex;
}

.crafting-queue-item .progress-foreground {
    background-color: rgba(250, 255, 126, 0.62);
    flex-direction: row;
    justify-content: center;
    height: 100%;
    width: 25%;
}

.crafting-recipe {
    border-left-color: rgba(255, 255, 255, 0.39);
    border-right-color: rgba(255, 255, 255, 0.39);
    border-top-color: rgba(255, 255, 255, 0.39);
    border-bottom-color: rgba(255, 255, 255, 0.39);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
    min-height: 32px;
    min-width: 100px;
}

.crafting-recipe:hover {
    background-color: rgba(23, 152, 183, 0.2);
    border-left-color: rgba(85, 223, 241, 0.4);
    border-right-color: rgba(85, 223, 241, 0.4);
    border-top-color: rgba(85, 223, 241, 0.4);
    border-bottom-color: rgba(85, 223, 241, 0.4);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.crafting-recipe__uncraftable:hover {
    background-color: rgba(183, 25, 23, 0.2);
    border-left-color: rgba(243, 69, 56, 0.4);
    border-right-color: rgba(243, 69, 56, 0.4);
    border-top-color: rgba(243, 69, 56, 0.4);
    border-bottom-color: rgba(243, 69, 56, 0.4);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.crafting-recipe .item-list {
    flex-direction: row;
}

.crafting-input {
    width: 16px;
    height: 16px;
    background-image: url('project://database/Assets/UI/bg_default.png?fileID=2800000&guid=c73eb54f62139d64087a3e6d1e440760&type=3#bg_default');
}

.crafting-input__missing {
    -unity-background-image-tint-color: rgb(217, 26, 26);
}

.crafting-input > .name {
    font-size: 8px;
    bottom: 0;
    position: absolute;
    left: 50%;
    right: 50%;
    -unity-text-align: upper-center;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.crafting-input > .icon {
    background-image: url('project://database/Assets/UI/crosshair.png?fileID=2800000&guid=18c36555461a00541bedc3bed7a78b41&type=3#crosshair');
    flex-grow: 1;
    -unity-background-image-tint-color: rgb(115, 115, 115);
}

.crafting-input > .stack {
    position: absolute;
    right: 0;
    top: 0;
    -unity-text-align: upper-right;
    font-size: 10px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.poi-marker {
    justify-content: center;
    align-items: flex-start;
}

.poi-marker Label {
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: lower-left;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 4px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    justify-content: flex-end;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    background-color: rgba(0, 0, 0, 0.67);
    align-items: flex-start;
    display: none;
}

.poi-marker.highlighted Label {
    display: flex;
}

.poi-marker #Icon {
    width: 24px;
    height: 24px;
    background-image: url('project://database/Assets/UI/target_marker.png?fileID=2800000&guid=aef2665a177dcb043b9b9593211bf248&type=3#target_marker');
}

.poi-marker #Icon.Star {
    background-image: url('project://database/Assets/UI/target_marker_star.png?fileID=2800000&guid=903195b968a03134eaaa8b62d0efdc6f&type=3#target_marker_star');
}

.poi-marker #Icon.Planet {
    background-image: url('project://database/Assets/UI/target_marker_planet.png?fileID=2800000&guid=df2d46c2ef2e279489234579778b5db3&type=3#target_marker_planet');
}

.poi-marker > VisualElement {
    left: -12px;
    top: -12px;
    flex-direction: row;
}

.hotkey-label {
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    font-size: 16px;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.29);
}
