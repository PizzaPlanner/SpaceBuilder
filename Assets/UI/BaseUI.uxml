<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="default.uss" />
    <ui:VisualElement name="MapInfo" style="position: absolute; right: 0; top: 0;">
        <ui:Label text="Label" display-tooltip-when-elided="true" name="Sector" />
        <ui:Label text="Label" display-tooltip-when-elided="true" name="Coordinates" />
        <ui:Label text="Label" display-tooltip-when-elided="true" name="Forward" />
    </ui:VisualElement>
    <ui:VisualElement name="ConstructionBorder" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-left-width: 10px; border-right-width: 10px; border-top-width: 10px; border-bottom-width: 10px; border-left-color: rgba(0, 178, 255, 0.58); border-right-color: rgba(0, 178, 255, 0.58); border-top-color: rgba(0, 178, 255, 0.58); border-bottom-color: rgba(0, 178, 255, 0.58); display: none;" />
    <AdminConsole style="position: absolute; width: 30%; height: 25%; display: none;" />
    <ui:VisualElement name="DockInfo" style="position: absolute; left: 0; bottom: 0; align-items: center; justify-content: center;">
        <ui:VisualElement name="System" class="dockingbutton dockingbutton-on" style="flex-direction: row; align-items: center; -unity-background-scale-mode: stretch-to-fill; justify-content: flex-start; width: 100%; margin-top: 1px; margin-bottom: 1px; background-image: url(&apos;/Assets/UI/bg_default.png&apos;);">
            <ui:VisualElement style="width: 28px; height: 28px; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px; background-image: url(&apos;/Assets/UI/coorsys_system.png&apos;);" />
            <ui:Label text="System" display-tooltip-when-elided="true" style="margin-right: 5px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Station" class="dockingbutton" style="flex-direction: row; align-items: center; justify-content: flex-start; width: 100%; margin-top: 1px; margin-bottom: 1px; background-image: url(&apos;/Assets/UI/bg_default.png&apos;);">
            <ui:VisualElement style="width: 28px; height: 28px; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px; background-image: url(&apos;/Assets/UI/coorsys_local.png&apos;);" />
            <ui:Label text="Station" display-tooltip-when-elided="true" style="margin-right: 5px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Swap" style="position: absolute; right: 15%; background-image: url(&apos;/Assets/UI/bg_slim.png&apos;);">
            <ui:VisualElement style="flex-direction: row; align-items: center; -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0; -unity-background-scale-mode: stretch-to-fill;">
                <ui:VisualElement style="width: 14px; height: 14px; -unity-background-scale-mode: stretch-to-fill; background-image: url(&apos;/Assets/UI/swap.png&apos;);" />
                <ui:Label text="G" display-tooltip-when-elided="true" style="font-size: 10px; padding-left: 2px; padding-right: 2px; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; -unity-text-align: middle-left;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Crosshair" style="width: 16px; height: 16px; position: absolute; left: 50%; top: 50%; right: 50%; bottom: 50%; background-image: url(&apos;/Assets/UI/crosshair.png&apos;);" />
    <ui:VisualElement name="ContextMenu" picking-mode="Ignore" style="left: 60%; top: 50%; display: flex; max-width: 200px; align-items: flex-start;">
        <ui:VisualElement name="MainAction" style="flex-direction: row; align-items: center; background-image: url(&apos;/Assets/UI/bg_slim.png&apos;);">
            <ui:VisualElement style="width: 24px; height: 24px;" />
            <ui:Label text="Build" display-tooltip-when-elided="true" name="MainActionName" />
        </ui:VisualElement>
    </ui:VisualElement>
    <InventoryElement name="Hotbar" style="position: absolute; flex-direction: row; left: 50%; right: 50%; bottom: 0; justify-content: center; align-items: flex-end;" />
    <ui:VisualElement name="Inventory" picking-mode="Ignore" style="align-items: center; justify-content: space-around; flex-direction: row; position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <InventoryElement name="MyBag" class="inventory">
            <InventoryButton />
            <InventoryButton />
            <InventoryButton />
            <InventoryButton />
            <InventoryButton />
        </InventoryElement>
        <ui:VisualElement name="Crafting" style="background-image: url(&apos;/Assets/UI/bg_slim.png&apos;); width: 128px; height: 128px; -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20;" />
        <InventoryElement name="RemoteBag" class="inventory" />
    </ui:VisualElement>
    <ui:VisualElement name="Center" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: flex-end; justify-content: center;">
        <ui:VisualElement name="BuildMenu" style="flex-wrap: wrap; height: 50%; -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; background-image: url(&apos;/Assets/UI/bg_slim.png&apos;); display: none;">
            <BuilderButton class="builder-button__Active" />
            <BuilderButton />
            <BuilderButton />
            <BuilderButton />
            <BuilderButton />
            <BuilderButton />
            <BuilderButton />
            <BuilderButton class="inventory" />
            <BuilderButton />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
