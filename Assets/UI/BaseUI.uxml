        <ui:VisualElement name="Station" class="dockingbutton" style="flex-direction: row; align-items: center; justify-content: flex-start; width: 100%; margin-top: 1px; margin-bottom: 1px; background-image: url(&apos;project://database/Assets/UI/bg_default.png?fileID=2800000&amp;guid=c73eb54f62139d64087a3e6d1e440760&amp;type=3#bg_default&apos;);">
            <ui:VisualElement style="width: 28px; height: 28px; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px; background-image: url(&apos;project://database/Assets/UI/coorsys_local.png?fileID=2800000&amp;guid=43fb2bd82828bcb4e99ccc29bbd14ac6&amp;type=3#coorsys_local&apos;);" />
