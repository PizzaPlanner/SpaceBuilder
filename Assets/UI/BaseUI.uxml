    <ui:VisualElement name="POIMarkers" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
    <ui:VisualElement name="BuildingUI" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="DestructionBorder" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-left-width: 10px; border-right-width: 10px; border-top-width: 10px; border-bottom-width: 10px; border-left-color: rgba(255, 69, 40, 0.58); border-right-color: rgba(255, 69, 40, 0.58); border-top-color: rgba(255, 69, 40, 0.58); border-bottom-color: rgba(255, 69, 40, 0.58); display: none; align-items: center;" />
        <ui:VisualElement name="BlueprintBorder" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-left-width: 10px; border-right-width: 10px; border-top-width: 10px; border-bottom-width: 10px; border-left-color: rgba(0, 178, 255, 0.58); border-right-color: rgba(0, 178, 255, 0.58); border-top-color: rgba(0, 178, 255, 0.58); border-bottom-color: rgba(0, 178, 255, 0.58); display: none; align-items: center;">
            <ui:Label text="Some Text" display-tooltip-when-elided="true" style="font-size: 20px; -unity-font-style: bold; background-color: rgba(75, 75, 75, 0.19); border-left-color: rgba(0, 178, 255, 0.58); border-right-color: rgba(0, 178, 255, 0.58); border-top-color: rgba(0, 178, 255, 0.58); border-bottom-color: rgba(0, 178, 255, 0.58); border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; margin-top: -1px;" />
