        <Main.ActionButton name="Build" Hotkey="B" style="background-image: url(&apos;project://database/Assets/3rdParty/64%20flat%20icons/png/128px/Tools_Hammer.png?fileID=2800000&amp;guid=926cdad46da8d3946a06209965661efb&amp;type=3#Tools_Hammer&apos;);" />
        <Main.ActionButton name="Parts" Hotkey="T" style="background-image: url(&apos;project://database/Assets/3rdParty/64%20flat%20icons/png/128px/Inventory_Book.png?fileID=2800000&amp;guid=14a30e668006aa14f92003524e6667f7&amp;type=3#Inventory_Book&apos;);" />
        <Main.ActionButton name="Inventory" Hotkey="C" style="background-image: url(&apos;project://database/Assets/3rdParty/64%20flat%20icons/png/128px/World_Chest.png?fileID=2800000&amp;guid=6b62d05057d633044b3dc427188695a5&amp;type=3#World_Chest&apos;);" />
        <Main.ActionButton name="Map" style="background-image: url(&apos;project://database/Assets/3rdParty/64%20flat%20icons/png/128px/World_Compass.png?fileID=2800000&amp;guid=6ea0e3de66db60b4895a5af021ec2f96&amp;type=3#World_Compass&apos;);" />
