    <InventoryElement name="Hotbar" style="position: absolute; flex-direction: row; left: 50%; right: 50%; bottom: 0; justify-content: center; align-items: flex-end;" />
    <ui:VisualElement name="Inventory" picking-mode="Ignore" style="align-items: center; justify-content: space-around; flex-direction: row; position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <InventoryElement name="MyBag" class="inventory" style="display: none;">
