        <ui:VisualElement name="DestructionBorder" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-left-width: 10px; border-right-width: 10px; border-top-width: 10px; border-bottom-width: 10px; border-left-color: rgba(255, 69, 40, 0.58); border-right-color: rgba(255, 69, 40, 0.58); border-top-color: rgba(255, 69, 40, 0.58); border-bottom-color: rgba(255, 69, 40, 0.58); display: none; align-items: center;" />
