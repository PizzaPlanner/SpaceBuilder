        </ui:VisualElement>
        <ui:VisualElement name="Construction" style="background-image: url(&apos;project://database/Assets/UI/bg_slim.png?fileID=2800000&amp;guid=cc32439c45babc04593dca5896662d0a&amp;type=3#bg_slim&apos;); -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; padding-left: 2px; padding-right: 2px; padding-top: 2px; padding-bottom: 2px; display: none;">
            <ui:VisualElement name="ProgressBarBack" style="height: 22px; border-left-color: rgba(255, 255, 255, 0.39); border-right-color: rgba(255, 255, 255, 0.39); border-top-color: rgba(255, 255, 255, 0.39); border-bottom-color: rgba(255, 255, 255, 0.39); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; min-width: 128px;">
                <ui:VisualElement name="progressbar" style="width: 58%; height: 100%; background-color: rgb(224, 219, 149);" />
            </ui:VisualElement>
            <ui:VisualElement name="ItemList" />
        </ui:VisualElement>
