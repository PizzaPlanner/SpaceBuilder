            <ui:Label text="Some Text" display-tooltip-when-elided="true" style="font-size: 20px; -unity-font-style: bold; background-color: rgba(75, 75, 75, 0.19); border-left-color: rgba(0, 178, 255, 0.58); border-right-color: rgba(0, 178, 255, 0.58); border-top-color: rgba(0, 178, 255, 0.58); border-bottom-color: rgba(0, 178, 255, 0.58); border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; margin-top: -1px;" />
