    <ui:VisualElement name="ActionIcons" style="position: absolute; right: 0; bottom: 0; flex-direction: row-reverse; justify-content: flex-end; background-color: rgba(30, 38, 46, 0.82); border-left-color: rgb(26, 44, 63); border-right-color: rgb(26, 44, 63); border-top-color: rgb(26, 44, 63); border-bottom-color: rgb(26, 44, 63); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; padding-left: 2px; padding-right: 2px; padding-top: 2px; padding-bottom: 2px;">
