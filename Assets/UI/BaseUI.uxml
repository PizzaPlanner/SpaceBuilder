    <ui:VisualElement name="DockInfo" style="position: absolute; left: 0; bottom: 0; align-items: center; justify-content: center;">
        <ui:VisualElement name="System" class="dockingbutton dockingbutton-on" style="flex-direction: row; align-items: center; -unity-background-scale-mode: stretch-to-fill; justify-content: flex-start; width: 100%; margin-top: 1px; margin-bottom: 1px; background-image: url(&apos;project://database/Assets/UI/bg_default.png?fileID=2800000&amp;guid=c73eb54f62139d64087a3e6d1e440760&amp;type=3#bg_default&apos;);">
