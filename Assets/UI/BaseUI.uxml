        <ui:VisualElement name="Icons" style="position: absolute; right: 0; bottom: 0; flex-direction: row-reverse; justify-content: flex-end;">
            <ui:VisualElement name="BuildButton" style="background-image: url(&apos;project://database/Assets/UI/removemode.png?fileID=2800000&amp;guid=f09e848341690ed4ca9ff3582facad8b&amp;type=3#removemode&apos;); width: 64px; height: 64px;">
