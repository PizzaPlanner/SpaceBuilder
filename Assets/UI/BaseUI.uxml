        <InventoryElement name="RemoteBag" class="inventory" style="display: none;" />
    </ui:VisualElement>
    <ui:VisualElement name="TargetInfo" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); position: absolute; left: 50%; right: 50%; top: 300px; align-items: center;">
        <Grid.UI.GridInfoWindow style="display: none;" />
    </ui:VisualElement>
    <ui:VisualElement name="Center" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;">
        <ui:VisualElement name="BuildMenu" style="flex-wrap: wrap; height: 50%; -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; background-image: url(&apos;project://database/Assets/UI/bg_slim.png?fileID=2800000&amp;guid=cc32439c45babc04593dca5896662d0a&amp;type=3#bg_slim&apos;); display: flex;" />
    </ui:VisualElement>
    <ui:VisualElement name="DebugUI" picking-mode="Ignore" tabindex="-1" style="align-items: flex-start; display: none; justify-content: space-between; flex-direction: row;">
        <ui:VisualElement name="Settings" style="background-color: rgba(55, 55, 55, 0.22); padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;">
            <ui:Label text="±Speed" display-tooltip-when-elided="true" name="MoreSpeed" enable-rich-text="false" class="debug-button" />
            <ui:Label text="Colliders" display-tooltip-when-elided="true" name="Colliders" enable-rich-text="false" class="debug-button" />
            <ui:EnumField type="PlayerTargetSystem+PlayerTargetMode, Grid" name="TargetFilter" tabindex="-1" class="debug-button" />
        </ui:VisualElement>
        <BlueprintLibraryWindow name="BlueprintLibraryWindow" />
        <ui:VisualElement name="InfoTexts" tabindex="-1" style="background-color: rgba(55, 55, 55, 0.22); position: absolute; top: 150px;">
            <ui:Foldout text="--Player--" value="false" tabindex="-1">
                <ui:Label name="player" />
            </ui:Foldout>
            <ui:Foldout text="--Sectors--" value="false" tabindex="-1">
                <ui:Label display-tooltip-when-elided="true" name="sectors" />
            </ui:Foldout>
            <ui:Foldout text="--Things--" value="false" tabindex="-1">
                <ui:Label name="things" />
                <ui:EnumField label="POI Markers" type="POIMarker+MarkerSettings+MarkerStyle, Main" value="Default" style="display: none;" />
            </ui:Foldout>
            <ui:Foldout text="--Grids--" name="Grids" value="false" tabindex="-1">
                <ui:Toggle label="Show Target" name="target" />
                <ui:Toggle label="Show AABBs" name="aabbs" />
                <ui:Toggle label="Show Rooms" name="rooms" />
                <ui:Toggle label="Show Occupations" name="occupations" />
            </ui:Foldout>
        </ui:VisualElement>
        <AdminConsole name="AdminConsole" style="position: absolute; display: none; right: 50%; left: 25%; top: 0; min-height: 150px; width: 50%;" />
    </ui:VisualElement>
</ui:UXML>
