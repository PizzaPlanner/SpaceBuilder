        <ui:VisualElement name="ConstructionBorder" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-left-width: 10px; border-right-width: 10px; border-top-width: 10px; border-bottom-width: 10px; border-left-color: rgba(0, 255, 99, 0.58); border-right-color: rgba(0, 255, 99, 0.58); border-top-color: rgba(0, 255, 99, 0.58); border-bottom-color: rgba(0, 255, 99, 0.58); display: none; align-items: center;" />
    </ui:VisualElement>
    <ui:VisualElement name="SteeringOverlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; align-items: center; justify-content: center; cursor: url(&apos;project://database/Assets/UI/shipSteeringCursor.png?fileID=2800000&amp;guid=9ae11426ac19173439e43db57bd5085b&amp;type=3#shipSteeringCursor&apos;);">
        <ui:VisualElement picking-mode="Ignore" style="align-items: center; justify-content: center; background-image: url(&apos;project://database/Assets/UI/steering_overlay.png?fileID=2800000&amp;guid=2390d33e35567484db6db67e82ae9e65&amp;type=3#steering_overlay&apos;); width: 256px; height: 256px;">
            <ui:VisualElement name="Cursor" picking-mode="Ignore" style="background-image: url(&apos;project://database/Assets/3rdParty/64%20flat%20icons/png/64px/Modifiers_Accuracy.png?fileID=2800000&amp;guid=13dbe3e19f5da6849a01f0f4678e8f01&amp;type=3#Modifiers_Accuracy&apos;); width: 32px; height: 32px;" />
        </ui:VisualElement>
