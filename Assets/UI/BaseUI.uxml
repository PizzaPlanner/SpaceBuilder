            <ui:VisualElement style="width: 28px; height: 28px; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px; background-image: url(&apos;project://database/Assets/UI/coorsys_system.png?fileID=2800000&amp;guid=c2e97b68c263c2540b96550bf1f92d1a&amp;type=3#coorsys_system&apos;);" />
