Wiki {
    border-left-color: rgb(168, 168, 168);
    border-right-color: rgb(168, 168, 168);
    border-top-color: rgb(168, 168, 168);
    border-bottom-color: rgb(168, 168, 168);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    background-color: rgb(82, 82, 82);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-direction: column;
    position: relative;
    align-items: stretch;
    margin-top: 100px;
    margin-right: 100px;
    margin-bottom: 100px;
    margin-left: 100px;
}

Wiki > #Search .unity-base-field__input {
    background-color: rgb(63, 63, 63);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(159, 159, 159);
    border-right-color: rgb(159, 159, 159);
    border-top-color: rgb(159, 159, 159);
    border-bottom-color: rgb(159, 159, 159);
}

Wiki > #Search {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 5px;
    margin-left: 0;
}

Wiki > TabView .unity-tab__header {
    background-color: rgb(63, 63, 63);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(159, 159, 159);
    border-right-color: rgb(159, 159, 159);
    border-top-color: rgb(159, 159, 159);
    border-bottom-color: rgb(159, 159, 159);
}

Wiki > TabView {
    flex-grow: 1;
}

Wiki > TabView #References {
    align-items: flex-start;
}

Wiki > TabView #navigate {
    align-items: flex-start;
    flex-direction: row;
    flex-wrap: wrap;
}

Wiki > TabView #navigate > WikiSearchResultButton {
    align-items: flex-start;
    flex-direction: row;
    flex-wrap: wrap;
    min-width: 25%;
}

WikiTagSearchButton {
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(116, 142, 143);
    border-right-color: rgb(116, 142, 143);
    border-top-color: rgb(116, 142, 143);
    border-bottom-color: rgb(116, 142, 143);
    width: 25%;
    -unity-text-align: middle-center;
    font-size: 16px;
}

WikiSearchResultButton {
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(143, 138, 116);
    border-right-color: rgb(143, 138, 116);
    border-top-color: rgb(143, 138, 116);
    border-bottom-color: rgb(143, 138, 116);
    flex-direction: row;
}

WikiSearchResultButton > #Icon {
    width: 32px;
    height: 32px;
}

WikiSearchResultButton > #RecipeContent {
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
    flex-direction: row;
}

WikiIdLinkButton {
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(85, 145, 86);
    border-right-color: rgb(85, 145, 86);
    border-top-color: rgb(85, 145, 86);
    border-bottom-color: rgb(85, 145, 86);
}

WikiIdLinkButton.inline {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

DetailPage > #Header {
    font-size: 20px;
    -unity-font-style: bold;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
}

DetailPage > #Body {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

DetailPage > #Header > #Icon {
    width: 64px;
    height: 64px;
}

Wiki .unity-tab-view__header-container {
    flex-shrink: 0;
}
